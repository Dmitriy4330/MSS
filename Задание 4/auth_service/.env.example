# Database
POSTGRES_USER=your_database_user
POSTGRES_PASSWORD=your_strong_password
POSTGRES_DB=auth_db
POSTGRES_SERVER=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://your_database_user:your_strong_password@db:5432/auth_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT
SECRET_KEY=your-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7